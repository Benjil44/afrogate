# Backend runtime environment for /etc/afrows/afrows.env.
# Replace every placeholder before starting the service.

PORT=7000
HOST=127.0.0.1
CORS_ORIGIN=https://afrows.example.com
DATABASE_URL=postgresql://afrows_app:replace-with-runtime-db-password@127.0.0.1:5432/afrows
# Prefer setting DATABASE_MIGRATION_URL only in a temporary migration shell or separate
# root-readable migration env file, not in the long-running backend service env.
# DATABASE_MIGRATION_URL=postgresql://afrows_migrator:replace-with-migration-db-password@127.0.0.1:5432/afrows
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Prefer a hash in production. Leave plaintext password empty when a hash is configured.
AFROWS_SUPERADMIN_USERNAME=superadmin
AFROWS_SUPERADMIN_PASSWORD=
AFROWS_SUPERADMIN_PASSWORD_HASH=replace-with-scrypt-password-hash
ADMIN_SESSION_SECRET=replace-with-long-random-session-secret
ADMIN_SESSION_TTL_SECONDS=28800
# Production/default managed admin users live in PostgreSQL. The file is only a
# legacy fallback/import source when explicitly enabled.
AFROWS_ADMIN_USERS_STORE=database
AFROWS_ADMIN_USERS_FILE=/var/lib/afrows/admin-users.json
AFROWS_ADMIN_USERS_IMPORT_FILE=true

# Legacy fallbacks. Prefer login sessions and database-issued agent tokens. Rotate database agent
# tokens with POST /api/agents/:serverId/tokens/rotate, then update the agent service env.
AFROWS_ADMIN_TOKEN=
AFROWS_AGENT_TOKEN=

# Required before storing Settings/server secrets. Must decode to exactly 32 bytes.
AFROWS_SECRETS_KEY=replace-with-32-byte-base64-or-64-char-hex
AFROWS_SECRETS_KEY_ID=production-v1
# Optional separate HMAC key for paid-number hashes. Falls back to AFROWS_SECRETS_KEY.
AFROWS_IDENTITY_HASH_KEY=replace-with-long-random-identity-hash-key

# Optional control-plane egress proxy for Telegram/API calls from restricted servers.
AFROWS_OUTBOUND_PROXY_URL=

# Superadmin Settings can store Telegram secrets encrypted/write-only; env values stay as bootstrap/fallback.
AFROWS_TELEGRAM_ALERTS_ENABLED=false
AFROWS_TELEGRAM_BOT_TOKEN=
AFROWS_TELEGRAM_ALERT_CHAT_ID=
AFROWS_TELEGRAM_API_BASE_URL=https://api.telegram.org
AFROWS_TELEGRAM_TIMEOUT_MS=10000
AFROWS_ALERT_DELIVERY_INTERVAL_SECONDS=10
AFROWS_ALERT_DELIVERY_BATCH_SIZE=20
AFROWS_TELEGRAM_ALERT_COOLDOWN_SECONDS=300
AFROWS_VILLAGE_ALERT_ENABLED=true
# TLS Encrypted ClientHello source for the Germany (and Ireland WS) customer links.
# Hides the afrows.com SNI from ISP DPI (Shatel freezes afrows.com-SNI flows after ~64 KB).
# Clients without ECH support ignore it. Empty = no ech= param (old behaviour).
AFROWS_DE_ENTRY_ECH=crypto.cloudflare.com+udp://1.1.1.1
AFROWS_INBOUND_ECH=
# USA remote exit (second remote exit next to Germany). EVERYTHING OFF BY DEFAULT;
# with these unset the behaviour is identical to 0.116.0 (no USA link, no ssh).
# Management + metering: when AFROWS_US_MGMT_ENABLED=true, Afrows adu's every active
# under-quota VLESS config onto the USA inbound afrows-us-ws:10085, rmu's over-quota /
# disabled / deleted / archived ones, and meters /var/lib/afrows/us-usage.json
# (ledger source 'usa-xray', own baseline table) into the SAME customer quota.
# Never enable the USA entry link without the mgmt+metering, or USA traffic is free.
AFROWS_US_MGMT_ENABLED=false
# ssh destination: an ssh_config Host alias carrying HostName, IdentityFile and the
# ProxyCommand (through the local socks). Default afrows-us-mgmt.
AFROWS_US_MGMT_SSH=afrows-us-mgmt
# Optional explicit key (-i). Empty = use the alias's IdentityFile.
AFROWS_US_MGMT_KEY=
# USA breaker cap (seconds; own breaker, a USA outage never skips Germany calls).
AFROWS_US_MGMT_BACKOFF_MAX_SECONDS=300
# USA usage poll (default 60, clamp 15..3600). USA quota cutoff latency ~= this
# recorder tick (30 s) + this interval + one rmu (<= ~95 s at defaults while the link is up).
AFROWS_US_USAGE_INTERVAL_SECONDS=60
# Full USA membership re-sync period (default 300, clamp 60..3600).
AFROWS_US_MEMBERSHIP_SWEEP_SECONDS=300
# Per-customer server access (0.118.0). Local xray inbound tags that ARE the Iran /
# "Shatel" entry: a customer with Shatel off is kept off (and rmu'd from) these only.
# Default afrows-in,afrows-in-tcp. afrows-reality and WireGuard are never gated.
AFROWS_XRAY_IRAN_INBOUND_TAGS=afrows-in,afrows-in-tcp
# How often the local access gate re-issues rmu for Shatel/Germany-off customers
# (default 300, clamp 60..3600); remote sites re-issue on their membership re-sync.
AFROWS_LOCAL_ACCESS_SWEEP_SECONDS=300
# Customer link "<name> · USA" (third link, after Germany and Shatel):
# vless://<uuid>@HOST:PORT?encryption=none&security=tls&sni=SNI&fp=FP&type=ws&host=WS_HOST&path=WS_PATH
# HOST and SNI are required (HOST = a Cloudflare IP); WS_HOST defaults to SNI.
AFROWS_US_ENTRY_ENABLED=false
AFROWS_US_ENTRY_HOST=
AFROWS_US_ENTRY_SNI=us.afrows.com
AFROWS_US_ENTRY_PORT=443
AFROWS_US_ENTRY_WS_PATH=/afrowsus
AFROWS_US_ENTRY_WS_HOST=
AFROWS_US_ENTRY_FP=chrome
# Optional TLS ECH source (same semantics as AFROWS_DE_ENTRY_ECH). Empty = no ech=.
AFROWS_US_ENTRY_ECH=
# Public refreshable subscription URL per client config (GET /sub/<token>, nginx -> /api/sub/).
# The token is HMAC-SHA256(secret, "<configId>:<version>") and is never stored (only its sha256).
# Unset or shorter than 32 chars = feature OFF (no URL shown, route returns 404). Changing the
# secret invalidates every customer's subscription URL. Generate: openssl rand -base64 48
AFROWS_SUBSCRIPTION_SECRET=
AFROWS_SUBSCRIPTION_BASE_URL=https://app.afrows.com/sub
AFROWS_VILLAGE_ALERT_REMINDER_MINUTES=360
AFROWS_DE_MGMT_BACKOFF_MAX_SECONDS=300
# Customer low-data / data-finished Telegram push (decimal GB threshold, 1..1000).
AFROWS_LOW_QUOTA_ALERT_ENABLED=true
AFROWS_LOW_QUOTA_ALERT_GB=5

AFROWS_OUTBOUND_HEALTH_SCHEDULER_ENABLED=true
AFROWS_OUTBOUND_HEALTH_SCAN_INTERVAL_SECONDS=10
AFROWS_OUTBOUND_HEALTH_BATCH_SIZE=20
AFROWS_OUTBOUND_HEALTH_TIMEOUT_MS=5000

AFROWS_ROUTE_QUALITY_AGGREGATION_ENABLED=true
AFROWS_ROUTE_QUALITY_AGGREGATION_INTERVAL_SECONDS=300
AFROWS_ROUTE_QUALITY_AGGREGATION_LOOKBACK_HOURS=48
AFROWS_ROUTE_QUALITY_PREDICTION_LOOKAHEAD_HOURS=8

# Keep disabled until the production apply engines are implemented and audited.
AFROWS_ROUTE_DATA_PLANE_APPLY_ENABLED=false
AFROWS_PROTOCOL_SERVER_APPLY_ENABLED=false
AFROWS_PROTOCOL_SERVER_APPLY_LIVE_EXECUTOR_ENABLED=false
AFROWS_PROTOCOL_SERVER_APPLY_SECRET_DECRYPT_ENABLED=false
AFROWS_PROTOCOL_SERVER_APPLY_CREDENTIAL_DECRYPT_ENABLED=false

AFROWS_ALERT_ENGINE_ENABLED=true
AFROWS_ALERT_ENGINE_INTERVAL_SECONDS=10
AFROWS_ALERT_ENGINE_BATCH_SIZE=100
AFROWS_ALERT_STALE_SERVER_SECONDS=90
AFROWS_ALERT_STALE_METRICS_SECONDS=120
AFROWS_ALERT_CPU_WARNING_PERCENT=85
AFROWS_ALERT_CPU_CRITICAL_PERCENT=95
AFROWS_ALERT_RAM_WARNING_PERCENT=85
AFROWS_ALERT_RAM_CRITICAL_PERCENT=95
AFROWS_ALERT_DISK_WARNING_FREE_PERCENT=15
AFROWS_ALERT_DISK_CRITICAL_FREE_PERCENT=10
AFROWS_ALERT_PING_WARNING_MS=100
AFROWS_ALERT_PING_CRITICAL_MS=150
AFROWS_ALERT_JITTER_WARNING_MS=40
AFROWS_ALERT_JITTER_CRITICAL_MS=80
AFROWS_ALERT_PACKET_LOSS_WARNING_PERCENT=1
AFROWS_ALERT_PACKET_LOSS_CRITICAL_PERCENT=5

# Behind nginx (and the Cloudflare tunnel) the backend sees 127.0.0.1 for every request.
# true = per-client rate limits key on the first X-Forwarded-For entry (needed for /sub/).
AFROWS_RATE_LIMIT_TRUST_PROXY_HEADERS=true
