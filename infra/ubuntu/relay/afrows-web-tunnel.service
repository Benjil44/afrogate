[Unit]
Description=Afrows website reverse tunnel: USA 127.0.0.1:18444 -> local nginx :443 (via USA over Cloudflare)
After=network-online.target xray.service
Wants=network-online.target

[Service]
User=afrows
# ssh starts ProxyCommand through $SHELL; afrows has a nologin shell.
Environment=SHELL=/bin/sh
# USA sshd (127.0.0.1:22 on the USA) over the Afrows xray loopback socks
# us-mgmt-socks (127.0.0.1:1083) -> via-usa (Cloudflare). No Borjino.
ExecStart=/usr/bin/ssh -F none -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ConnectTimeout=20 -o IdentitiesOnly=yes -o HostKeyAlias=afrows-us-mgmt -o UserKnownHostsFile=/etc/afrows/us_mgmt_known_hosts -o StrictHostKeyChecking=yes -o "ProxyCommand=/usr/bin/nc -X 5 -x 127.0.0.1:1083 %%h %%p" -i /etc/afrows/web_tunnel_key -R 127.0.0.1:18444:127.0.0.1:443 afrows-relay@127.0.0.1
Restart=always
RestartSec=10
MemoryMax=64M

[Install]
WantedBy=multi-user.target
