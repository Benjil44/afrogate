# Afrows Germany-mgmt relay chain: Afrows -> USA -> Germany (no Borjino).
# The USA hop is the USA sshd at 127.0.0.1:22, reached over the Afrows xray
# loopback socks us-mgmt-socks (127.0.0.1:1083) -> via-usa (Cloudflare).
# Used ONLY by afrows-de-relay.service (ssh -F) to hold one authenticated
# ControlMaster to Germany. The USA hop accepts only a TCP forward to Germany:22.
Host usa-relay
  HostName 127.0.0.1
  Port 22
  User afrows-relay
  ProxyCommand /usr/bin/nc -X 5 -x 127.0.0.1:1083 %h %p
  HostKeyAlias afrows-us-mgmt
  UserKnownHostsFile /etc/afrows/us_mgmt_known_hosts
  IdentityFile /etc/afrows/de_relay_key
  IdentitiesOnly yes
  StrictHostKeyChecking yes
  BatchMode yes
  ConnectTimeout 20
  ServerAliveInterval 15
  ServerAliveCountMax 3
Host 162.19.253.235
  User root
  ProxyJump usa-relay
  IdentityFile /opt/afrogate/.de_mgmt_key
  IdentitiesOnly yes
  UserKnownHostsFile /opt/afrogate/.ssh/known_hosts
  StrictHostKeyChecking yes
  BatchMode yes
  ConnectTimeout 25
  ServerAliveInterval 15
  ServerAliveCountMax 3
  ControlPath /run/afrows/de-relay.sock
