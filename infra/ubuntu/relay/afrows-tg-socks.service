[Unit]
Description=Afrows Telegram SOCKS proxy 127.0.0.1:1081 -> api.telegram.org:443 only (via Borjino -> USA)
After=network-online.target
Wants=network-online.target

[Service]
User=afrows
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/afrows/de_relay_known_hosts -o "ProxyCommand=/usr/bin/ssh -F none -o BatchMode=yes -o IdentitiesOnly=yes -i /etc/afrows/de_relay_key -o UserKnownHostsFile=/etc/afrows/de_relay_known_hosts -W %%h:%%p afrows-relay@185.252.30.127" -i /etc/afrows/tg_socks_key -D 127.0.0.1:1081 afrows-relay@93.127.140.50
Restart=always
RestartSec=10
MemoryMax=64M

[Install]
WantedBy=multi-user.target
