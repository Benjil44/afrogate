limit_req_zone $binary_remote_addr zone=afrows_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=afrows_login:10m rate=3r/m;
# Public subscription URLs (/sub/<token>): VPN apps refresh every ~12h, so a low per-IP rate.
# app.afrows.com arrives through the Cloudflare tunnel (remote_addr is loopback), so key
# subscription refreshes on the visitor IP Cloudflare reports; direct hits fall back to
# the TCP peer. A spoofed header only buys the sender their own bucket (tokens are 192-bit).
map $http_cf_connecting_ip $afrows_sub_client {
    ""      $binary_remote_addr;
    default $http_cf_connecting_ip;
}
limit_req_zone $afrows_sub_client zone=afrows_sub:10m rate=30r/m;

server {
    listen 80;
    server_name afrows.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name afrows.example.com;

    root /opt/afrows/apps/dashboard/dist;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/afrows.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/afrows.example.com/privkey.pem;

    client_max_body_size 1m;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # Content-Security-Policy: the dashboard is a static SPA that talks only to same-origin /api.
    # 'unsafe-inline' style is required by the current Tailwind/inline-style usage; review before tightening.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    location = /api/auth/login {
        limit_req zone=afrows_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:7000/api/auth/login;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /api/ {
        limit_req zone=afrows_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:7000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Public, unauthenticated subscription endpoint for VPN apps (GET only, never cached;
    # the backend sends Cache-Control: no-store. No add_header here: it would drop the
    # server-level security headers for this location).
    # `^~` keeps the regex locations below (and the SPA fallback) from taking it; access_log
    # off keeps live tokens out of the nginx logs.
    # Single public path for subscriptions: /api/sub/ would bypass the /sub/ limits
    # and log tokens via the generic /api/ block.
    location ^~ /api/sub/ {
        return 404;
    }

    location ^~ /sub/ {
        limit_except GET { deny all; }
        limit_req zone=afrows_sub burst=10 nodelay;
        proxy_pass http://127.0.0.1:7000/api/sub/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        access_log off;
        proxy_read_timeout 15s;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }

    location ~* \.(?:css|js|woff2?|png|jpg|jpeg|gif|webp|ico)$ {
        expires 7d;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
