# Afrows Germany edge agent config.
# Copy to /etc/afrows/afrows-de-agent.env (chmod 600, root-only) and set the token.
#
# The agent runs ON the Germany box. It reaches the backend over Cloudflare
# (Germany -> Cloudflare -> backend keeps working even when the direct/village
# route is filtered), pulls GET /api/edge/de/clients, reconciles the local xray
# WS + XHTTP inbounds, and mirrors the set into config.json so a reboot/restart
# keeps everyone. It only ever manages cc_<id>@afrows customer users; any other
# client (e.g. afrows-chain@afrows) is preserved.

# Backend base URL (Cloudflare-fronted). The agent appends /api/edge/de/clients.
AFROWS_EDGE_URL=https://app.afrows.com
# MUST equal AFROWS_EDGE_TOKEN in the backend env (/etc/afrows/afrows.env).
AFROWS_EDGE_TOKEN=__SET_TO_THE_SAME_TOKEN_AS_THE_BACKEND__

# Local xray + config (defaults match the Germany box layout).
AFROWS_DE_CONFIG=/usr/local/etc/afrows-xray-de/config.json
AFROWS_DE_XRAY_API=127.0.0.1:10085
AFROWS_DE_XRAY_BIN=/usr/local/bin/xray
AFROWS_DE_WS_TAG=afrows-de-ws
AFROWS_DE_WS_PORT=8090
AFROWS_DE_XHTTP_TAG=afrows-de-xhttp
AFROWS_DE_XHTTP_PORT=8091
AFROWS_DE_INTERVAL=60
