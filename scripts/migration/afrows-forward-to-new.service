# Temporary (2026-10-20 zirsakht migration): the OLD Afrows server 94.74.145.199 only
# forwards customer + router ports to the NEW server 185.252.30.123, so configs that
# still carry the old IP keep working until customers refresh. SSH (22) stays local.
# Install on the OLD box after stopping its own xray/nginx/wg/ipsec services; remove
# (systemctl disable --now) once traffic on the old IP has drained, then retire the box.
[Unit]
Description=Afrows: forward customer/router ports from the old server to the new one
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=NEW=185.252.30.123
Environment=TCP=80,443,8080,12345
Environment=UDP=12345,51820,51821,51822,51900,51901,51902,51903,500,4500,1701,52000
ExecStart=/bin/sh -c 'sysctl -qw net.ipv4.ip_forward=1; \
  iptables -t nat -C PREROUTING -i eth0 -p tcp -m multiport --dports $TCP -m comment --comment afrows-fwd -j DNAT --to-destination $NEW 2>/dev/null || iptables -t nat -A PREROUTING -i eth0 -p tcp -m multiport --dports $TCP -m comment --comment afrows-fwd -j DNAT --to-destination $NEW; \
  iptables -t nat -C PREROUTING -i eth0 -p udp -m multiport --dports $UDP -m comment --comment afrows-fwd -j DNAT --to-destination $NEW 2>/dev/null || iptables -t nat -A PREROUTING -i eth0 -p udp -m multiport --dports $UDP -m comment --comment afrows-fwd -j DNAT --to-destination $NEW; \
  iptables -t nat -C POSTROUTING -o eth0 -d $NEW -m conntrack --ctstate DNAT -m comment --comment afrows-fwd -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -o eth0 -d $NEW -m conntrack --ctstate DNAT -m comment --comment afrows-fwd -j MASQUERADE; \
  iptables -t mangle -C FORWARD -o eth0 -p tcp --tcp-flags SYN,RST SYN -m comment --comment afrows-fwd -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || iptables -t mangle -A FORWARD -o eth0 -p tcp --tcp-flags SYN,RST SYN -m comment --comment afrows-fwd -j TCPMSS --clamp-mss-to-pmtu'
ExecStop=/bin/sh -c 'iptables-save | grep -q afrows-fwd || exit 0; \
  iptables -t nat -D PREROUTING -i eth0 -p tcp -m multiport --dports $TCP -m comment --comment afrows-fwd -j DNAT --to-destination $NEW; \
  iptables -t nat -D PREROUTING -i eth0 -p udp -m multiport --dports $UDP -m comment --comment afrows-fwd -j DNAT --to-destination $NEW; \
  iptables -t nat -D POSTROUTING -o eth0 -d $NEW -m conntrack --ctstate DNAT -m comment --comment afrows-fwd -j MASQUERADE; \
  iptables -t mangle -D FORWARD -o eth0 -p tcp --tcp-flags SYN,RST SYN -m comment --comment afrows-fwd -j TCPMSS --clamp-mss-to-pmtu'

[Install]
WantedBy=multi-user.target
