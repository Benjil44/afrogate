# Afrows deploy engine config — COPY to deploy.env (gitignored) and fill in.
# No secrets belong here beyond SSH destination names; authentication is key-based
# via your ~/.ssh/config. deploy.env is gitignored so real hosts never reach git.

# Ordered SSH destinations to try (space-separated). DIRECT first, then fallbacks.
# Each is an ~/.ssh/config alias or user@host. Define the actual host/key/ProxyJump
# in ~/.ssh/config — NOT here. Example ~/.ssh/config:
#
#   Host afrows-vps-direct
#       HostName <vps-ip>
#       User root
#       IdentityFile ~/.ssh/afrogate_deploy
#
#   Host afrows-vps-via-router          # MikroTik / jump fallback path
#       HostName <vps-tunnel-or-ip>
#       User root
#       IdentityFile ~/.ssh/afrogate_deploy
#       ProxyJump <router-or-bastion-you-can-reach>
#
AFROWS_DEPLOY_TARGETS="afrows-vps-direct afrows-vps-via-router"

# On-box paths (defaults are correct for the standard install).
AFROWS_REMOTE_DIR="/opt/afrows"
AFROWS_SRC_REMOTE="/root/afrows-src.tar.gz"
